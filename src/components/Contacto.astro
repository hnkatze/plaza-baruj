---
import { site } from '../data/site';

interface Channel {
	label: string;
	value: string;
	href?: string;
}

/**
 * Only configured channels are rendered. Empty values are omitted on purpose:
 * a placeholder link in production is worse than a missing row.
 * TODO(content): fill email and instagram in src/data/site.ts.
 */
const candidates: (Channel | null)[] = [
	site.whatsapp
		? {
				label: 'WhatsApp',
				value: site.whatsappLabel,
				href: `https://wa.me/${site.whatsapp}`,
			}
		: null,
	site.email ? { label: 'Correo', value: site.email, href: `mailto:${site.email}` } : null,
	site.instagram
		? {
				label: 'Instagram',
				value: `@${site.instagram}`,
				href: `https://instagram.com/${site.instagram}`,
			}
		: null,
	site.address ? { label: 'Dirección', value: site.address } : null,
	site.mapsUrl
		? { label: 'Ubicación', value: 'Ver en Google Maps', href: site.mapsUrl }
		: null,
];

const channels = candidates.filter((channel): channel is Channel => channel !== null);
---

<section class="py-section" id="contacto">
	<div class="page grid items-start gap-[clamp(2rem,5vw,4rem)] lg:grid-cols-2">
		<div data-reveal>
			<p class="eyebrow">05 · Contacto</p>
			<h2 class="text-[clamp(2.1rem,5vw,3.4rem)]">Hablemos.</h2>
			<p class="lede mt-5">
				¿Te interesa un local, querés reservar el hotel o saber qué está disponible? Escribinos
				directo.
			</p>
		</div>

		<div class="border-t border-ink/10 pt-5" data-reveal>
			{
				channels.length > 0 ? (
					<ul>
						{channels.map((channel) => (
							<li class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 border-b border-ink/10 py-4">
								<span class="text-[0.72rem] font-semibold uppercase tracking-[0.14em] text-ink-soft">
									{channel.label}
								</span>
								{channel.href ? (
									<a class="font-display text-[1.15rem] hover:text-terra" href={channel.href}>
										{channel.value}
									</a>
								) : (
									<span class="font-display text-[1.15rem]">{channel.value}</span>
								)}
							</li>
						))}
					</ul>
				) : (
					<p class="py-2 text-[0.95rem] text-ink-soft">
						Los canales de contacto están por confirmar.
					</p>
				)
			}

			<div class="mt-6 flex flex-wrap gap-3">
				<a
					class="btn btn--solid"
					href={site.directionsUrl}
					target="_blank"
					rel="noopener">Cómo llegar</a
				>
				<a
					class="btn btn--outline"
					href={site.wazeUrl}
					target="_blank"
					rel="noopener">Abrir en Waze</a
				>
			</div>
		</div>
	</div>
</section>
