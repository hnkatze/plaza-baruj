---
import { hotel, images, locales, site } from '../data/site';
---

<section
	class="hero relative isolate overflow-hidden border-b border-ink/10 pt-[clamp(2.5rem,7vw,5.5rem)] pb-[clamp(3.5rem,8vw,6rem)]"
	id="inicio"
>
	<div class="page grid items-center gap-[clamp(2.5rem,5vw,4rem)] lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)]">
		<div>
			<p class="eyebrow" data-reveal style="--reveal-i: 0">01 · La calle</p>
			<h1 class="mb-6">
				<span class="hero-mask">
					<span
						class="block text-[0.72rem] font-semibold uppercase tracking-[0.5em] text-ink-soft"
						style="--rise-i: 0"
					>
						{site.nameKicker}
					</span>
				</span>
				<span class="hero-mask">
					<span
						class="mt-1 block text-[clamp(3.4rem,10vw,7.5rem)] leading-[0.88] tracking-[-0.04em]"
						style="--rise-i: 1"
					>
						{site.nameWord}
					</span>
				</span>
				<span class="hero-mask">
					<span
						class="mt-5 block max-w-[32ch] font-sans text-[clamp(0.95rem,1.7vw,1.15rem)] font-medium leading-normal tracking-normal text-ink-soft"
						style="--rise-i: 2"
					>
						{locales.length} locales abajo, {hotel.unidades} unidades arriba.
					</span>
				</span>
			</h1>
			<p class="lede" data-reveal style="--reveal-i: 2">
				Una plaza de dos plantas en una sola dirección: el comercio ocurre en la calle y el
				descanso, un piso más arriba.
			</p>
			<div class="mt-8 flex flex-wrap gap-3" data-reveal style="--reveal-i: 3">
				<a class="btn btn--solid" href="#hotel">Ver el hotel</a>
				<a class="btn btn--outline" href="#locales">Ver los locales</a>
			</div>
		</div>

		<figure class="m-0 overflow-hidden rounded-card border border-ink/10 bg-sand-2" data-reveal style="--reveal-i: 2">
			<img
				class="aspect-video w-full object-cover"
				src={images.fachada.src}
				alt={images.fachada.alt}
				width={images.fachada.width}
				height={images.fachada.height}
				loading="eager"
				fetchpriority="high"
				decoding="async"
			/>
			<figcaption
				class="border-t border-ink/10 px-4 py-3 text-[0.7rem] font-semibold uppercase tracking-[0.16em] text-ink-soft"
			>
				Fachada · locales en planta baja, hotel en la segunda planta
			</figcaption>
		</figure>
	</div>
</section>
