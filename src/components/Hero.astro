---
import { heroFotos, hotel, locales, site } from '../data/site';
---

<section
	class="hero relative isolate overflow-hidden border-b border-ink/10 pt-[clamp(2.5rem,7vw,5.5rem)] pb-[clamp(3.5rem,8vw,6rem)]"
	id="inicio"
>
	<div class="page grid items-center gap-[clamp(2.5rem,5vw,4rem)] lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]">
		<div>
			<p class="eyebrow" data-reveal style="--reveal-i: 0">01 · La calle</p>
			<h1 class="mb-6">
				<span class="hero-mask">
					<span
						class="block text-[0.72rem] font-semibold uppercase tracking-[0.5em] text-ink-soft"
						style="--rise-i: 0"
					>
						{site.nameKicker}
					</span>
				</span>
				<span class="hero-mask">
					<span
						class="mt-1 block text-[clamp(3.4rem,10vw,7.5rem)] leading-[0.88] tracking-[-0.04em]"
						style="--rise-i: 1"
					>
						{site.nameWord}
					</span>
				</span>
				<span class="hero-mask">
					<span
						class="mt-5 block max-w-[32ch] font-sans text-[clamp(0.95rem,1.7vw,1.15rem)] font-medium leading-normal tracking-normal text-ink-soft"
						style="--rise-i: 2"
					>
						{locales.length} locales abajo, {hotel.unidades} unidades arriba.
					</span>
				</span>
			</h1>
			<p class="lede" data-reveal style="--reveal-i: 2">
				Una plaza de dos plantas en una sola dirección: el comercio ocurre en la calle y el
				descanso, un piso más arriba.
			</p>
			<div class="mt-8 flex flex-wrap gap-3" data-reveal style="--reveal-i: 3">
				<a class="btn btn--solid" href="#hotel">Ver el hotel</a>
				<a class="btn btn--outline" href="#locales">Ver los locales</a>
			</div>
		</div>

		<figure
			class="m-0 overflow-hidden rounded-card border border-ink/10 bg-sand-2"
			data-hero-carousel
			data-reveal
			style="--reveal-i: 2"
		>
			<ul class="hero-slides aspect-[4/3]" data-hero-slides>
				{
					heroFotos.map((foto, index) => (
						<li
							class={index === 0 ? 'hero-slide is-active' : 'hero-slide'}
							data-hero-slide
							aria-hidden={index === 0 ? 'false' : 'true'}
						>
							<img
								class="size-full object-cover"
								src={foto.src}
								alt={foto.alt}
								width={foto.width}
								height={foto.height}
								loading={index === 0 ? 'eager' : 'lazy'}
								fetchpriority={index === 0 ? 'high' : 'auto'}
								decoding="async"
							/>
						</li>
					))
				}
			</ul>
			<figcaption
				class="flex items-center justify-between gap-4 border-t border-ink/10 px-4 py-3"
			>
				<span
					class="text-[0.7rem] font-semibold uppercase tracking-[0.16em] text-ink-soft"
					data-hero-caption
				>
					{heroFotos[0].caption}
				</span>
				<span class="flex shrink-0 gap-1.5" role="group" aria-label="Fotos de la portada">
					{
						heroFotos.map((foto, index) => (
							<button
								type="button"
								class="h-1.5 w-4 rounded-full bg-ink/20 transition duration-300 hover:bg-ink/40 aria-[current=true]:w-7 aria-[current=true]:bg-ink"
								data-hero-dot={index}
								data-caption={foto.caption}
								aria-label={`Ver: ${foto.caption}`}
								aria-current={index === 0 ? 'true' : 'false'}
							/>
						))
					}
				</span>
			</figcaption>
		</figure>
	</div>
</section>
