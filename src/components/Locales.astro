---
import { galeriaFachadas, locales, localesGaleria, type LocalStatus } from '../data/site';

const statusLabel: Record<LocalStatus, string> = {
	disponible: 'Disponible',
	ocupado: 'Ocupado',
	'por-confirmar': 'Por confirmar',
};

// Static classes: Tailwind cannot see runtime-built class names.
const statusDot: Record<LocalStatus, string> = {
	disponible: 'bg-green',
	ocupado: 'bg-ink/40',
	'por-confirmar': 'bg-transparent ring-1 ring-inset ring-ink/35',
};

const PLACEHOLDER_RUBRO = 'Por confirmar';
// The gallery reads the building first and the units second: the facade shots span
// two columns, the unit shots one each.
const galeria = [
	...galeriaFachadas.map((foto) => ({
		foto,
		cols: 'sm:col-span-2',
		aspect: 'aspect-[4/3]',
	})),
	...localesGaleria.map((foto) => ({ foto, cols: '', aspect: 'aspect-[3/4]' })),
];

const pendientes = locales.filter((local) => local.status === 'por-confirmar').length;

// Every placeholder card carries the same sentence, so it is printed once for the
// whole deck instead of six times. Real per-local copy still renders on its card.
const descripciones = new Set(locales.map((local) => local.descripcion));
const descripcionComun = descripciones.size === 1 ? locales[0]?.descripcion : null;
---

<section class="py-section" id="locales">
	<div class="page">
		<div
			class="mb-[clamp(2rem,5vw,3.5rem)] grid items-end gap-x-12 gap-y-6 lg:grid-cols-2"
		>
			<div data-reveal style="--reveal-i: 0">
				<p class="eyebrow">03 · Planta baja</p>
				<h2 class="text-[clamp(2.1rem,5vw,3.4rem)]">
					{locales.length} locales, una sola planta baja.
				</h2>
			</div>
			<p class="lede" data-reveal style="--reveal-i: 1">
				Cada local tiene entrada directa desde la calle y comparte el flujo de la plaza: quien
				viene a uno, pasa por todos.
			</p>
		</div>

		<ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-pulse-grid data-pulse-count="2" data-reveal>
			{
				locales.map((local, index) => (
					<li
						data-pulse-item
						class="group relative flex min-h-[11.5rem] flex-col overflow-hidden rounded-card border border-ink/10 bg-sand p-[clamp(1.4rem,2.6vw,1.9rem)] transition duration-500 hover:-translate-y-1 hover:border-ink/25 hover:bg-white hover:shadow-[0_22px_46px_-32px_rgba(23,21,15,0.55)]"
					>
						<span
							aria-hidden="true"
							class="pointer-events-none absolute -top-3 right-3 font-display text-[4.6rem] leading-none text-ink/[0.06] transition-colors duration-300 group-hover:text-terra/15"
						>
							{String(index + 1).padStart(2, '0')}
						</span>

						<div class="relative flex items-center gap-2">
							<span
								aria-hidden="true"
								class={`size-1.5 shrink-0 rounded-full ${statusDot[local.status]}`}
							/>
							<span class="text-[0.64rem] font-semibold uppercase tracking-[0.15em] text-ink-soft">
								{statusLabel[local.status]}
							</span>
						</div>

						<h3 class="relative mt-auto pt-8 text-[1.4rem] leading-tight">
							{local.nombre}
						</h3>
						{local.rubro !== PLACEHOLDER_RUBRO && (
							<p class="relative mt-1.5 text-[0.72rem] font-semibold uppercase tracking-[0.14em] text-terra">
								{local.rubro}
							</p>
						)}

						{local.descripcion !== descripcionComun && (
							<p class="relative mt-4 text-[0.88rem] text-ink-soft">{local.descripcion}</p>
						)}
					</li>
				))
			}
		</ul>

		{
			pendientes > 0 && (
				<p class="mt-6 max-w-[64ch] text-[0.88rem] text-ink-soft">
					{pendientes === locales.length
						? `Todavía estamos confirmando la disponibilidad de los ${locales.length} locales: el estado de cada uno se actualiza acá a medida que el inquilino lo confirma.`
						: `Estamos confirmando la disponibilidad de ${pendientes} de los ${locales.length} locales; el resto ya tiene estado confirmado.`}
				</p>
			)
		}

		<div class="mt-[clamp(2.5rem,5vw,4rem)]" data-reveal>
			<h3 class="eyebrow">Cómo se entrega un local</h3>
			<p class="lede mb-6">
				La planta baja tal como está hoy: la fachada desde la calle y los locales vacíos,
				con el piso, las paredes y el baño terminados. Tocá una foto para verla en grande.
			</p>
			<ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
				{
					galeria.map(({ foto, cols, aspect }) => (
						<li class={cols}>
							<button
								type="button"
								class="group/photo block w-full cursor-zoom-in overflow-hidden rounded-card border border-ink/10 bg-sand-2 transition duration-500 hover:border-ink/25 hover:shadow-[0_22px_46px_-32px_rgba(23,21,15,0.55)]"
								data-lightbox
								data-foto-src={foto.src}
								data-foto-alt={foto.alt}
								aria-label={`Ver en grande: ${foto.alt}`}
							>
								<img
									class={`${aspect} w-full object-cover transition-transform duration-500 group-hover/photo:scale-[1.02]`}
									src={foto.src}
									alt={foto.alt}
									width={foto.width}
									height={foto.height}
									loading="lazy"
									decoding="async"
								/>
							</button>
						</li>
					))
				}
			</ul>
		</div>

		<dialog class="lightbox" data-lightbox-dialog aria-label="Foto del local">
			<img data-lightbox-img src={galeria[0]?.foto.src} alt="" width="1600" height="1200" />
			<form method="dialog">
				<button class="lightbox-close" aria-label="Cerrar la foto">Cerrar</button>
			</form>
		</dialog>
	</div>
</section>

<script>
	/* Local gallery lightbox: a native <dialog>, so Esc, the focus trap and the
	   return of focus to the tile come from the platform. */
	const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox-dialog]');
	const dialogImg = dialog?.querySelector<HTMLImageElement>('[data-lightbox-img]');

	if (dialog && dialogImg) {
		document.querySelectorAll<HTMLButtonElement>('[data-lightbox]').forEach((trigger) => {
			trigger.addEventListener('click', () => {
				dialogImg.src = trigger.dataset.fotoSrc ?? '';
				dialogImg.alt = trigger.dataset.fotoAlt ?? '';
				document.documentElement.classList.add('is-locked');
				dialog.showModal();
			});
		});

		dialog.addEventListener('close', () => {
			document.documentElement.classList.remove('is-locked');
		});

		// A click on the backdrop lands on the dialog itself; the image and the
		// button do not bubble up to it.
		dialog.addEventListener('click', (event) => {
			if (event.target === dialog) dialog.close();
		});
	}
</script>
