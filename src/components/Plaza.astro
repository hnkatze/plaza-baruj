---
import { hotel, locales, servicios } from '../data/site';

const units = locales.map((local) => local.slug.slice(-2));

/** One label per hotel unit: they sit above the ground floor, one local wide each. */
const unidades = Array.from({ length: hotel.unidades }, (_, index) => String(index + 1));

const pad = (value: number) => String(value).padStart(2, '0');

const hechos = [
	{ valor: pad(locales.length), etiqueta: 'locales comerciales en planta baja' },
	{ valor: pad(hotel.unidades), etiqueta: 'unidades de hotel en la segunda planta' },
	{ valor: pad(hotel.habitacionesPorUnidad), etiqueta: 'habitaciones dentro de cada unidad' },
];
---

<section class="bg-sand-2 py-section" id="plaza">
	<div class="page">
		<div class="grid gap-[clamp(2rem,5vw,3.5rem)] lg:grid-cols-2">
			<div data-reveal style="--reveal-i: 0">
				<p class="eyebrow">02 · La plaza</p>
				<h2 class="text-[clamp(2.1rem,5vw,3.4rem)]">
					Dos plantas, dos formas de usar la misma dirección.
				</h2>
			</div>

			<div class="flex flex-col gap-4" data-reveal style="--reveal-i: 1">
				<p class="lede">
					En la planta baja, {locales.length} locales comerciales abiertos a la calle: el punto
					donde la plaza se conecta con el movimiento diario del barrio.
				</p>
				<p class="lede">
					En la segunda planta, el hotel. Un piso de distancia que separa el ruido del
					comercio del descanso del huésped, sin sacarlo del centro de todo.
				</p>
			</div>
		</div>

		<figure
			class="group m-0 mt-[clamp(2.5rem,5vw,3.5rem)] flex flex-col gap-2.5 rounded-card border border-ink/10 bg-sand p-[clamp(1.25rem,3vw,2rem)]"
			data-reveal
			aria-label={`Esquema de Plaza Baruj: ${locales.length} locales comerciales en planta baja y ${hotel.unidades} unidades de hotel en la segunda planta, cada una del ancho de un local, con el área social sobre el primer local`}
			data-pulse-grid
			data-pulse-count="2"
		>
			<figcaption
				class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 text-[0.7rem] font-semibold uppercase tracking-[0.16em] text-ink-soft"
			>
				<span>Segunda planta</span>
				<span class="text-[0.6rem] tracking-[0.14em] text-ink-soft/60">
					Hotel · {hotel.unidades} unidades
				</span>
			</figcaption>

			<ul class="grid grid-cols-3 gap-1.5 sm:grid-cols-6">
				<li
					class="grid min-h-[clamp(3.5rem,7vw,4.75rem)] place-items-center rounded-card border border-dashed border-green/30 px-1 text-center text-[0.58rem] font-semibold uppercase leading-tight tracking-[0.12em] text-green/70"
				>
					Área social
				</li>
				{
					unidades.map((unidad) => (
						<li
							data-pulse-item
							class="pulse-dark grid min-h-[clamp(3.5rem,7vw,4.75rem)] place-items-center gap-0.5 rounded-card bg-green px-1 py-2 text-center text-sand transition duration-500"
						>
							<span class="font-display text-[0.95rem] leading-none">U{unidad}</span>
							<span class="text-[0.55rem] uppercase tracking-[0.12em] text-sand/55">
								{hotel.habitacionesPorUnidad} hab.
							</span>
						</li>
					))
				}
			</ul>

			<div class="my-1 h-px bg-ink/10" aria-hidden="true"></div>

			<figcaption
				class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 text-[0.7rem] font-semibold uppercase tracking-[0.16em] text-ink-soft"
			>
				<span>Planta baja</span>
				<span class="text-[0.6rem] tracking-[0.14em] text-ink-soft/60">
					{locales.length} locales
				</span>
			</figcaption>

			<ul class="grid grid-cols-3 gap-1.5 sm:grid-cols-6">
				{
					units.map((unit) => (
						<li
							data-pulse-item
							class="grid min-h-[clamp(3.5rem,7vw,4.75rem)] place-items-center rounded-card border border-ink/15 bg-sand-2 font-display text-base text-ink-soft transition duration-500 group-hover:border-ink/25 group-hover:bg-white group-hover:text-ink"
						>
							{unit}
						</li>
					))
				}
			</ul>
		</figure>

		<ul
			class="mt-[clamp(2rem,4vw,3rem)] grid gap-4 sm:grid-cols-3"
			data-reveal
		>
			{
				hechos.map((hecho) => (
					<li class="flex flex-col gap-1.5 rounded-card border border-ink/10 bg-sand p-[clamp(1.25rem,3vw,2rem)]">
						<span class="font-display text-[clamp(2rem,4vw,2.8rem)] leading-none text-green">
							{hecho.valor}
						</span>
						<span class="max-w-[22ch] text-[0.85rem] text-ink-soft">{hecho.etiqueta}</span>
					</li>
				))
			}
		</ul>

		<div class="mt-[clamp(2.25rem,4vw,3.25rem)]" data-reveal>
			<h3 class="mb-2 text-[0.7rem] font-semibold uppercase tracking-[0.16em] text-ink-soft">
				Servicios del edificio
			</h3>
			<p class="lede mb-6">
				Lo que la plaza comparte de punta a punta: no depende de cada local ni de cada unidad,
				está en el edificio.
			</p>
			<ul class="grid gap-x-10 gap-y-6 sm:grid-cols-2 lg:grid-cols-3">
				{
					servicios.map((servicio) => (
						<li>
							<h4 class="mb-1.5 text-[0.78rem] font-semibold uppercase tracking-[0.12em] text-terra">
								{servicio.titulo}
							</h4>
							<p class="text-[0.9rem] text-ink-soft">{servicio.detalle}</p>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>
