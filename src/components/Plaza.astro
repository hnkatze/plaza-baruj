---
import { locales } from '../data/site';

const units = locales.map((local) => local.slug.slice(-2));

const hechos = [
	{ valor: '05', etiqueta: 'locales comerciales en planta baja' },
	{ valor: '05', etiqueta: 'unidades de hotel en la segunda planta' },
	{ valor: '02', etiqueta: 'habitaciones dentro de cada unidad' },
];
---

<section class="bg-sand-2 py-section" id="plaza">
	<div class="page">
		<div class="grid gap-[clamp(2rem,5vw,3.5rem)] lg:grid-cols-2">
			<div data-reveal>
				<p class="eyebrow">02 · La plaza</p>
				<h2 class="text-[clamp(2.1rem,5vw,3.4rem)]">
					Dos plantas, dos formas de usar la misma dirección.
				</h2>
			</div>

			<div class="flex flex-col gap-4" data-reveal>
				<p class="lede">
					En la planta baja, cinco locales comerciales abiertos a la calle: el punto donde la
					plaza se conecta con el movimiento diario del barrio.
				</p>
				<p class="lede">
					En la segunda planta, el hotel. Un piso de distancia que separa el ruido del
					comercio del descanso del huésped, sin sacarlo del centro de todo.
				</p>
			</div>
		</div>

		<figure
			class="group m-0 mt-[clamp(2.5rem,5vw,3.5rem)] flex flex-col gap-2.5 rounded-brand border border-ink/10 bg-sand p-[clamp(1.25rem,3vw,2rem)]"
			data-reveal
			aria-label="Esquema de Plaza Baruj: cinco locales en planta baja y cinco unidades de hotel en la segunda planta"
		>
			<figcaption class="text-[0.7rem] font-semibold uppercase tracking-[0.16em] text-ink-soft">
				Segunda planta
			</figcaption>
			<div class="flex flex-col justify-center gap-0.5 rounded-brand bg-green px-6 py-5 text-sand">
				<span class="font-display text-2xl">Hotel</span>
				<span class="text-[0.85rem] text-sand/70">5 unidades · 2 habitaciones cada una</span>
			</div>

			<figcaption class="mt-1 text-[0.7rem] font-semibold uppercase tracking-[0.16em] text-ink-soft">
				Planta baja
			</figcaption>
			<ul class="grid grid-cols-5 gap-1.5">
				{
					units.map((unit) => (
						<li class="grid min-h-[clamp(3.5rem,7vw,4.75rem)] place-items-center rounded-brand border border-ink/20 bg-sand-2 font-display text-base text-ink-soft transition-colors group-hover:bg-white group-hover:text-ink">
							{unit}
						</li>
					))
				}
			</ul>
		</figure>

		<ul
			class="mt-[clamp(2rem,4vw,3rem)] grid gap-px border-y border-ink/10 bg-ink/10 sm:grid-cols-3"
			data-reveal
		>
			{
				hechos.map((hecho) => (
					<li class="flex flex-col gap-1.5 bg-sand-2 p-[clamp(1.25rem,3vw,2rem)]">
						<span class="font-display text-[clamp(2rem,4vw,2.8rem)] leading-none text-green">
							{hecho.valor}
						</span>
						<span class="max-w-[22ch] text-[0.85rem] text-ink-soft">{hecho.etiqueta}</span>
					</li>
				))
			}
		</ul>
	</div>
</section>
