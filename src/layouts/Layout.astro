---
import '../styles/global.css';
import TourProgress from '../components/TourProgress.astro';
import { geo, hotel, images, servicios, site } from '../data/site';

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;

/**
 * Every absolute URL on the page derives from site.url. While it is empty the
 * site still works locally: canonical, og:url and the sitemap line are omitted
 * instead of pointing somewhere wrong.
 */
const base = site.url.replace(/\/$/, '');
const abs = (path: string) => (base ? `${base}${path}` : path);
const canonical = base ? abs('/') : undefined;

const postalAddress = {
	'@type': 'PostalAddress',
	addressLocality: site.locality,
	addressRegion: site.region,
	addressCountry: site.country,
};

const geoCoordinates = {
	'@type': 'GeoCoordinates',
	latitude: geo.lat,
	longitude: geo.lng,
};

const plazaId = abs('/#plaza');

const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'LocalBusiness',
			'@id': plazaId,
			name: site.name,
			description: site.description,
			url: canonical,
			image: [images.fachada.src],
			telephone: `+${site.whatsapp}`,
			hasMap: site.mapsUrl,
			address: postalAddress,
			geo: geoCoordinates,
			amenityFeature: servicios.map((servicio) => ({
				'@type': 'LocationFeatureSpecification',
				name: servicio.titulo,
				description: servicio.detalle,
				value: true,
			})),
		},
		{
			'@type': 'Hotel',
			'@id': abs('/#hotel'),
			name: hotel.nombre,
			description: hotel.resumen,
			url: canonical,
			parentOrganization: { '@id': plazaId },
			telephone: `+${site.whatsapp}`,
			image: [images.cuarto1.src, images.cuarto2.src],
			address: postalAddress,
			geo: geoCoordinates,
			amenityFeature: hotel.equipamiento.map((name) => ({
				'@type': 'LocationFeatureSpecification',
				name,
				value: true,
			})),
		},
	],
};
---

<!doctype html>
<html lang="es-HN">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="theme-color" content="#162d28" />
		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow, max-image-preview:large" />
		{canonical && <link rel="canonical" href={canonical} />}

		<!-- Machine-readable entry points: markdown copy of the page + llms.txt index. -->
		<link rel="alternate" type="text/markdown" href={abs('/index.md')} />
		<link rel="describedby" type="text/plain" href={abs('/llms.txt')} />

		<link rel="preconnect" href="https://cdn.flujoo.dev" crossorigin />

		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_HN" />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{canonical && <meta property="og:url" content={canonical} />}
		<meta property="og:image" content={images.fachada.src} />
		<meta property="og:image:width" content={String(images.fachada.width)} />
		<meta property="og:image:height" content={String(images.fachada.height)} />
		<meta property="og:image:alt" content={images.fachada.alt} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={images.fachada.src} />

		<script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

		<script is:inline>
			document.documentElement.classList.add('js');
		</script>
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<slot />
		<TourProgress />
		<script>
			const targets = document.querySelectorAll('[data-reveal]');
			const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

			if (reduced || !('IntersectionObserver' in window)) {
				targets.forEach((target) => target.classList.add('is-visible'));
			} else {
				const observer = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (!entry.isIntersecting) return;
							entry.target.classList.add('is-visible');
							observer.unobserve(entry.target);
						});
					},
					{ rootMargin: '0px 0px -12% 0px', threshold: 0.08 },
				);

				targets.forEach((target) => observer.observe(target));
			}
		</script>

		<script>
			/**
			 * Ambient pulse: a few elements of a grid light up on their own, reusing the
			 * hover treatment. One timer per grid, only while that grid is on screen, and
			 * none at all under `prefers-reduced-motion`. `data-pulse-count` sets how many
			 * light up per tick (default 2).
			 */
			const TICK_MS = 1000;
			const reducedPulse = window.matchMedia('(prefers-reduced-motion: reduce)');

			if (!reducedPulse.matches) {
				document.querySelectorAll<HTMLElement>('[data-pulse-grid]').forEach((grid) => {
					const items = Array.from(grid.querySelectorAll<HTMLElement>('[data-pulse-item]'));
					if (items.length === 0) return;

					const perTick = Math.max(1, Number(grid.dataset.pulseCount) || 2);
					let timer: number | undefined;
					let lit: HTMLElement[] = [];

					const clear = () => {
						lit.forEach((item) => item.removeAttribute('data-pulse'));
						lit = [];
					};

					const pulse = () => {
						clear();
						const picks = new Set<HTMLElement>();
						while (picks.size < Math.min(perTick, items.length)) {
							picks.add(items[Math.floor(Math.random() * items.length)]!);
						}
						picks.forEach((item) => item.setAttribute('data-pulse', ''));
						lit = [...picks];
					};

					const observer = new IntersectionObserver(
						(entries) => {
							const visible = entries.some((entry) => entry.isIntersecting);

							if (visible && timer === undefined) {
								pulse();
								timer = window.setInterval(pulse, TICK_MS);
							} else if (!visible && timer !== undefined) {
								window.clearInterval(timer);
								timer = undefined;
								clear();
							}
						},
						{ threshold: 0.2 },
					);

					observer.observe(grid);
				});
			}
		</script>

		<script>
			/* Sticky header: gains a soft shadow once the page has scrolled. */
			const header = document.querySelector('[data-header]');

			if (header) {
				const sync = () => header.toggleAttribute('data-scrolled', window.scrollY > 8);
				sync();
				window.addEventListener('scroll', sync, { passive: true });
			}
		</script>
	</body>
</html>
