---
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Hotel from '../components/Hotel.astro';
import Locales from '../components/Locales.astro';
import Plaza from '../components/Plaza.astro';
import { site } from '../data/site';
import Layout from '../layouts/Layout.astro';

const title = `${site.name} — Locales comerciales y hotel en ${site.locality}`;
---

<Layout title={title} description={site.description}>
	<Header />
	<main id="contenido">
		<Hero />
		<Plaza />
		<Locales />
		<Hotel />
		<Contacto />
	</main>
	<Footer />
</Layout>
